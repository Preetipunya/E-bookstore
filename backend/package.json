{
  "name": "bookworm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Book Worm e-bookstore REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:docker": "node dist/migrate.js && node dist/seed/seed.js --if-empty && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/seed.ts",
    "db:reset": "tsx src/seed/seed.ts --reset",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^18.7.0-beta.19",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
